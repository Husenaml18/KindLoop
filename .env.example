# SQLite — no external account needed, works out of the box.
DATABASE_URL="file:./dev.db"

# Generate with: npx auth secret
AUTH_SECRET=""

# Optional — without these, a dev-only "Continue as Dev User" sign-in is used instead.
# Create a Google OAuth client at https://console.cloud.google.com/apis/credentials
# (Authorized redirect URI: http://localhost:3000/api/auth/callback/google)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional — without these, unlocking the paid template uses a mock in-app checkout instead.
# Get test-mode keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional — used to build absolute Stripe redirect URLs; falls back to the request origin.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — without this, the landing page uses random placeholder photos (picsum.photos) instead.
# Get a free key at https://www.pexels.com/api/
# PEXELS_API_KEY=
