# --- Database ----------------------------------------------------------------
# Prisma Postgres. `npx prisma postgres link --database <id>` writes this for you;
# it is a direct postgres:// string, so there is no pooled/unpooled pair to keep
# in step. Prisma 7 reads it from prisma.config.ts for the CLI and from the
# PrismaPg adapter in src/lib/prisma.ts at runtime — never from schema.prisma.
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# --- File storage -------------------------------------------------------------
# Uploads go to Vercel Blob when this is set, and to a local `uploads/` folder
# when it is not. Local disk is fine for development and impossible in
# production: a serverless filesystem is read-only apart from /tmp and is thrown
# away between requests, so every photo would either fail to save or vanish.
#
# On Vercel: Storage -> Create -> Blob, connect it to the project, and this is
# injected automatically. Nothing else changes — the same code reads it.
# BLOB_READ_WRITE_TOKEN=

# Generate with: npx auth secret
AUTH_SECRET=""

# --- Signing in by email ---------------------------------------------------
# Sign-in links go out by SMTP if SMTP_HOST is set, by Resend if AUTH_RESEND_KEY
# is set, and otherwise are printed to the terminal running `next dev` — enough
# to use and test the whole flow locally. A production build refuses that last
# fallback and errors rather than pretending to have sent an email.
#
# The address every sign-in link is sent from. Used by both SMTP and Resend.
# AUTH_EMAIL_FROM="Kindloop <hello@yourdomain.com>"
#
# Option A — SMTP (any mailbox you already own).
#   Port 465 is implicit TLS, 587 is STARTTLS. SMTP_SECURE only needs setting if
#   your host does something other than that.
#   Gmail / Google Workspace: smtp.gmail.com:587, and SMTP_PASSWORD must be an
#   App Password (https://myaccount.google.com/apppasswords), not your login.
#   Zoho: smtp.zoho.com:465 · Fastmail: smtp.fastmail.com:465
#   Mailgun: smtp.mailgun.org:587 · Brevo: smtp-relay.brevo.com:587
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASSWORD=
# SMTP_SECURE=
#
# Option B — Resend (https://resend.com, no SMTP settings to get right).
# AUTH_RESEND_KEY=re_...

# --- Signing in with Google ------------------------------------------------
# Optional — without these, a dev-only "Continue as Dev User" sign-in is offered
# instead. Create a client at https://console.cloud.google.com/apis/credentials
# (Authorized redirect URI: http://localhost:3000/api/auth/callback/google)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Optional — without these, unlocking the paid template uses a mock in-app checkout instead.
# Get test-mode keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional — used to build absolute Stripe redirect URLs; falls back to the request origin.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — without this, the landing page uses random placeholder photos (picsum.photos) instead.
# Get a free key at https://www.pexels.com/api/
# PEXELS_API_KEY=
