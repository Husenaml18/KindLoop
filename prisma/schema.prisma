generator client {
  /*
   * Prisma 7's generator. It emits real TypeScript into the repo rather than
   * patching `node_modules/@prisma/client` in place, which is what makes the
   * output survive a clean install and a bundler that does not expect a package
   * to rewrite itself at generate time.
   */
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  /*
   * No `url` here, and that is not an omission.
   *
   * Prisma 7 removed it from the schema: the CLI takes its connection string from
   * `prisma.config.ts`, and the client takes a driver adapter instead. One less
   * place for a live credential to sit, and one less way for the two to disagree.
   */
  provider = "postgresql"
}

// --- Auth.js Prisma adapter contract ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  isDevMock     Boolean   @default(false)
  /// A line or two about themselves, shown on their own profile only.
  bio           String?
  /// Optional and free-form, including "prefer not to say". Nothing in the
  /// product reads it — it exists so somebody can tell us how they'd like to be
  /// referred to, and it is theirs to clear at any time.
  gender        String?

  accounts Account[]
  sessions Session[]
  gifts    Gift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App domain models ---

model Gift {
  id       String  @id @default(cuid())
  slug     String  @unique
  template String
  content  String
  isPaid   Boolean @default(false)
  unlocked Boolean @default(false)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model Order {
  id               String @id @default(cuid())
  giftId           String
  /// Which experience inside a Personalized Website this paid for.
  ///
  /// Null for an ordinary paid gift, where the gift itself is the purchase and
  /// `Gift.unlocked` is the whole answer. A Personalized Website can hold several paid
  /// sections, so one gift may have several orders and each needs to say what it
  /// bought. Additive and nullable: every existing order keeps its meaning.
  templateId       String?
  gift             Gift   @relation(fields: [giftId], references: [id], onDelete: Cascade)
  provider         String
  status           String @default("pending")
  stripeCheckoutId String? @unique
  amountCents      Int
  currency         String  @default("usd")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([giftId])
}

/// Somebody who asked to hear when there's more.
///
/// Kept apart from `User` on purpose: joining the waitlist is not making an
/// account, and conflating the two would mean an address given for one reason
/// quietly becomes a login for another.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Which page they were on when they asked — useful, and nothing more.
  source    String   @default("footer")
  createdAt DateTime @default(now())
}
